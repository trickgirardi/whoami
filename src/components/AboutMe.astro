---
import Card from "./Card/index.astro";

const stack = [
  {
    group: "Languages",
    items: ["TypeScript", "Python"],
  },
  {
    group: "Frontend",
    items: ["React", "Next.js", "SvelteKit", "Vite", "Shadcn", "Tailwind CSS"],
  },
  {
    group: "Backend & APIs",
    items: ["Node.js", "Bun", "NestJS", "Express", "Fastify"],
  },
  {
    group: "Databases & ORM",
    items: ["PostgreSQL", "MongoDB", "Redis", "Prisma", "Drizzle", "Mongoose"],
  },
  {
    group: "Auth & Services",
    items: [
      "Better Auth",
      "Auth.js",
      "Keycloak",
      "Supabase",
      "Sanity CMS",
      "n8n",
    ],
  },
  {
    group: "DevOps & Tools",
    items: ["Linux", "Docker", "Debian & derivatives", "RHEL & derivatives"],
  },
  {
    group: "AI & Developer Tools",
    items: ["Cursor", "Claude Code", "Codex", "Hermes", "OpenCode"],
  },
];

const CHIP =
  "text-2xs px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-100 hover:border-primary-500 hover:text-white transition-colors duration-150 cursor-default";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-5"
  title="Stack & tools"
  class="pad-lg"
>
  <div class="flex flex-col gap-3">
    {
      stack.map(({ group, items }) => (
        <div class="flex flex-col gap-1.5">
          <span class="text-3xs uppercase tracking-wider text-darkslate-400">
            {group}
          </span>
          <div class="flex flex-wrap gap-1.5">
            {items.map((label) => (
              <span class={CHIP}>{label}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Card>
