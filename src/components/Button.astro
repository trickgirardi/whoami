---
interface Props {
  rounded?: boolean;
  compact?: boolean;
  class?: string;
  id?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}

const { rounded, compact, ...props } = Astro.props;
---

<span class={`btn-shell inline-flex w-fit ${compact ? "h-auto" : "h-full"}`}>
  <button
    {...props}
    class={`w-fit shadow-custom shadow-primary-500 active:shadow-none active:translate-x-[3px] active:translate-y-[3px] text-darkslate-50 border border-primary-500 hover:text-primary-500 transition-colors duration-100 ease-in-out bg-darkslate-900 cursor-pointer ${
      compact ? "h-9 px-3 py-1 text-xs" : "h-full text-xl max-h-[50px] px-5 py-2"
    } ${
      rounded ? "rounded-full" : "rounded-lg"
    } ${props.class ?? ""}`}
  >
    <slot />
  </button>
</span>
