---
import Card from "./Card/index.astro";

const projects = [
  {
    title: "nest-excel-stream",
    summary: "Exemplo de stream de arquivos Excel para aplicações Node.js.",
    technologies: "NestJS · ExcelJS · Prisma",
    href: "https://github.com/trickgirardi/nest-excel-stream",
  },
  {
    title: "Citros Flow",
    summary: "Sistema moderno e simples para gerenciamento de fluxo de caixa.",
    technologies: "Next.js · Supabase · Shadcn",
    href: "https://github.com/trickgirardi/citros-flow",
  },
  {
    title: "Project Three",
    summary: "Ut enim ad minim veniam, quis nostrud exercitation ullamco.",
    technologies: "Next.js · PostgreSQL",
    href: "https://example.com/project-three",
  },
  {
    title: "Project Four",
    summary: "Duis aute irure dolor in reprehenderit voluptate velit esse.",
    technologies: "Node.js · APIs",
    href: "https://example.com/project-four",
  },
];
---

<Card
  colSpan="xl:col-span-2"
  rowSpan="md:row-span-2"
  title="Projetos"
  class="pad-lg"
>
  <div class="grid grid-cols-2 gap-3 mt-3">
    {
      projects.map(({ title, summary, technologies, href }) => (
        <article class="min-w-0 flex flex-col gap-1">
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-bold hover:text-primary-400 transition-colors"
          >
            {title}
          </a>
          <p class="m-0 text-2xs leading-snug text-darkslate-200">{summary}</p>
          <span class="text-3xs uppercase tracking-wide text-darkslate-300">
            {technologies}
          </span>
        </article>
      ))
    }
  </div>
</Card>
